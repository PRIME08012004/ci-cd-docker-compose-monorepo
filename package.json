{
  "name": "ci-cd-monorepo-deploy",
  "private": true,
  "scripts": {
    
    "start:ws": "cd apps/websocket && bun run index.ts",
    "generate:db": "cd packages/db && bunx prisma generate",
    "start:backend": "cd apps/http-server && bun run src/index.ts",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "@types/bun": "latest"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "module": "index.ts",
  "type": "module"
}
